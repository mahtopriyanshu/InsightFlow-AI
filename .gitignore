# Python cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example
docs/API key details.txt
.streamlit/secrets.toml

# Local logs, coverage, and embedded database artifacts
*.log
.coverage
.coverage.*
htmlcov/
coverage.xml
*.sqlite
*.sqlite3
*.db

# Jupyter checkpoints
.ipynb_checkpoints/

# Generated reports (keep the placeholder file)
reports/*
!reports/.gitkeep

# Processed datasets (keep the placeholder file)
data/processed/*
!data/processed/.gitkeep

# IDE files
.vscode/
.idea/
*.code-workspace

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Raw datasets (keep only placeholder)
data/raw/*
!data/raw/.gitkeep

*.dump
